# Optional local overrides. Do not place portfolio data or credentials here.
PORTFOLIO_MANAGER_HOME=
PORTFOLIO_MANAGER_HOST=127.0.0.1
PORTFOLIO_MANAGER_PORT=8742

# Required for fundamentals, insider activity, and peers from SEC EDGAR.
# SEC asks automated clients to send a name and contact email, for example:
# PORTFOLIO_MANAGER_SEC_USER_AGENT="Jane Doe jane@example.com"
PORTFOLIO_MANAGER_SEC_USER_AGENT=
